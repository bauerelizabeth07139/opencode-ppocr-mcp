{
  "name": "dsh-ppocr",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: local OCR. It mounts the bundled PP-OCRv6 Medium stdio MCP server (PaddleOCR/PaddleX on ONNX Runtime, CPU only) and exposes mcp__ppocr__ocr_image and mcp__ppocr__ocr_pdf, so images and PDFs can be read without sending them anywhere.",
  "type": "module",
  "license": "MIT",
  "author": "bauerelizabeth07139",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bauerelizabeth07139/opencode-ppocr-mcp.git"
  },
  "homepage": "https://github.com/bauerelizabeth07139/opencode-ppocr-mcp#readme",
  "bugs": {
    "url": "https://github.com/bauerelizabeth07139/opencode-ppocr-mcp/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "assets",
    "test",
    "README.md",
    "LICENSE",
    "server.py",
    "requirements.txt"
  ],
  "engines": {
    "node": ">=22",
    "python": ">=3.8",
    "dsh": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "icon": "./assets/icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/plugin.test.mjs && node --import ./test/hooks.mjs test/mount.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "ocr",
    "paddleocr",
    "pdf",
    "onnxruntime"
  ]
}
